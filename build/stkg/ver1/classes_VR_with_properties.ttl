        bfstkg:Embark , bfstkg:Disembark , bfstkg:SendRadio , bfstkg:Wait ;
    bfstkg:hasStateAttribute
        bfstkg:Location , bfstkg:Heading , bfstkg:CurrentSpeed , bfstkg:OrderedSpeed ,
        bfstkg:Destroyed , bfstkg:Appearance , bfstkg:Invulnerable , bfstkg:Invisible ,
        bfstkg:Undetectable , bfstkg:Force , bfstkg:Superior , bfstkg:TaskedBySuperior ,
        bfstkg:UnitState , bfstkg:Resources , bfstkg:Pitch , bfstkg:IFF ,
        bfstkg:FreezeMovement , bfstkg:AIEnabled , bfstkg:NavigationEnabled , bfstkg:Formation ,
        bfstkg:FreezeFuelLevels , bfstkg:Armed , bfstkg:Loadout , bfstkg:RulesOfEngagement ,
        bfstkg:Target , bfstkg:TargetPriorityList , bfstkg:EngagementZones , bfstkg:SkillLevel ,
        bfstkg:FreezeMunitionLevels , bfstkg:Embarked , bfstkg:Disembarked , bfstkg:SensorAim ,
        bfstkg:SpotReports , bfstkg:TDLMessaging .


    rdfs:label "연료 고정"@ko , "FreezeFuelLevels"@en .

bfstkg:Armed a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "무장상태"@ko , "Armed"@en .

bfstkg:Loadout a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "적재무장"@ko , "Loadout"@en .

bfstkg:RulesOfEngagement a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "교전규칙"@ko , "RulesOfEngagement"@en .

bfstkg:Target a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "지정표적"@ko , "Target"@en .

bfstkg:TargetPriorityList a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "표적우선순위"@ko , "TargetPriorityList"@en .

bfstkg:EngagementZones a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "교전구역"@ko , "EngagementZones"@en .

bfstkg:SkillLevel a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "숙련도"@ko , "SkillLevel"@en .

bfstkg:FreezeMunitionLevels a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "탄약 고정"@ko , "FreezeMunitionLevels"@en .

bfstkg:Embarked a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "탑승중"@ko , "Embarked"@en .

bfstkg:Disembarked a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "하차상태"@ko , "Disembarked"@en .

bfstkg:SensorAim a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "센서 조준"@ko , "SensorAim"@en .

bfstkg:SpotReports a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "관측보고"@ko , "SpotReports"@en .

bfstkg:TDLMessaging a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "TDL 메시징"@ko , "TDLMessaging"@en .

bfstkg:HideOccupants a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "탑승자 은닉"@ko , "HideOccupants"@en .

bfstkg:Posture a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "자세"@ko , "Posture"@en .

bfstkg:Concealed a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "은폐"@ko , "Concealed"@en .

bfstkg:Surrendered a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "항복"@ko , "Surrendered"@en .

 


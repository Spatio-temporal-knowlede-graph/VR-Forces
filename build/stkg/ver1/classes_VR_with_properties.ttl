#################################################################
## individual_stkgformat_v1.ttl — 전장 STKG 스키마 (S4 모듈)
## individual_v1.ttl · classes_VR.ttl 과 병합해 사용. (2026-07-29 / 개편 2026-08-05)
##
## 목적: 데이터팀 관측 스트림(build/stkg/*_annotated.csv, 관측자별)을
##   지식그래프로 적재하는 '그릇'. 관측 중심 모델:
##       Observer(관측자) ──trackedBy── Track(관측자별 대상, trackingID로 식별)
##                                        └─observationOf─ Observation(관측 레코드 = CSV 1행)
##   Track은 관측자별 trackingID로 식별한다. subject(ENCAESAR002)는 정답(ground-truth)
##   실개체 마킹이며 트랙↔실개체 정합의 정답지 — 정합 알고리즘은 추후 연구(resolvedTo 비움).
## [전면 개편 2026-08-05] SpatioTemporalState → Observation 개명.
##   Track/개체정합(S4.3) 축 신설. 속성 domain을 Observation/Track으로 재배치.
#################################################################

#################################################################
# S4.1. 핵심 클래스 — 관측 모델 골격
#   ※ 실개체 계열(BattlefieldEntity·MilitaryUnit·Vehicle·Faction·EntityModel)과
#     L0 어휘(EntityState·SensorSource·NatureTerrain·Facility)는 여기서 정의하지
#     않는다 — individual_v1.ttl · classes_VR.ttl 병합으로 채워진다.
#################################################################

# 관측 플랫폼(source 컬럼). UAV 1~4, ground_truth. → 인스턴스는 S6.
# geo:Feature 하위 — UAV는 좌표를 가짐(ground_truth는 위치 없음이라 geometry 생략).
bfstkg:Observer a owl:Class ;
    rdfs:subClassOf prov:Agent , geo:Feature ;
    rdfs:label "관측자"@ko , "Observer"@en ;
    rdfs:comment "관측을 생성한 플랫폼. fixed_objects.json 기준(UAV 1~4, ground_truth)."@ko .

# 관측자별 대상(트랙). CSV subject 1건 = Track 1개. 실개체가 아니라 '한 관측자의 대상 인식'.
# 관측자가 다르면 같은 마킹(ENT72007)이라도 별개 Track — 정합은 S4.3(추후 연구).
bfstkg:Track a owl:Class ;
    rdfs:label "관측트랙"@ko , "Track"@en ;
    rdfs:comment "한 관측자가 인식한 개별 대상. CSV subject(관측자 로컬 ID)에 대응. 실개체 정합 전의 잠정 대상."@ko .

# 관측 레코드 = annotated CSV 1행. (구 SpatioTemporalState 개명)
bfstkg:Observation a owl:Class ;
    rdfs:subClassOf geo:Feature ;
    rdfs:label "관측"@ko , "Observation"@en ;
    rdfs:comment "특정 관측자가 특정 시각에 한 트랙에 대해 남긴 관측 1건(CSV 1행). 위치·운동·관계를 담는다. 구 SpatioTemporalState."@ko .

# 명명지점 — battlefield_layout.json의 LOC_*. 
bfstkg:Landmark a owl:Class ;
    rdfs:subClassOf geo:Feature ;
    rdfs:label "명명지점"@ko , "Landmark"@en ;
    rdfs:comment "웨이포인트·명명 진지 등. battlefield_layout.json의 LOC_*가 대응하며 좌표를 geo:hasGeometry로 갖는다."@ko .

# 공간 술어의 통합 치역(union) 
bfstkg:PlaceRef a owl:Class ;
    rdfs:label "지점참조"@ko , "PlaceRef"@en ;
    rdfs:comment "공간 대상(locatedAt·occupy·moveTo·fireAt 등)의 치역. 자연지형·시설물·명명지점의 합집합."@ko ;
    owl:unionOf ( bfstkg:NatureTerrain bfstkg:Facility bfstkg:Landmark ) .

# [미사용 2026-08-05] 현재 annotated CSV엔 이벤트가 없어 인스턴스가 생기지 않는다.
#   추후 이벤트 데이터(battle.jsonl의 event_id·role 등)를 담을 때 사용. participatesIn의 치역.
bfstkg:Event a owl:Class ;
    rdfs:label "이벤트"@ko , "Event"@en ;
    rdfs:comment "전투 이벤트. participatesIn의 치역. (현재 데이터 미사용 — 추후 이벤트 계층용)"@ko .

# 센서 인식 수준 어휘 — cid(원자료 CID)의 range. 값 0~4. 인스턴스는 S7.
bfstkg:RecognitionLevel a owl:Class ;
    rdfs:label "인식수준"@ko , "RecognitionLevel"@en ;
    rdfs:comment "센서가 대상을 얼마나 정확히 식별했는지의 단계(0~4). 원자료 CID 컬럼 값의 집합."@ko .

#################################################################
# S4.2. 관측 레코드 속성 (Observation) — annotated CSV 컬럼 직대응
#################################################################

bfstkg:observationOf a owl:ObjectProperty ;
    rdfs:domain bfstkg:Observation ; rdfs:range bfstkg:Track ;
    rdfs:label "대상트랙"@ko ; rdfs:comment "이 관측이 향하는 트랙. 트랙은 (관측자 + trackingID)로 식별. 원자료 키: trackingID(+source)."@ko .
bfstkg:observedBy a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:domain bfstkg:Observation ; rdfs:range bfstkg:Observer ;
    rdfs:label "관측주체"@ko ; rdfs:comment "이 관측을 낸 플랫폼. 원자료 키: source (예 'UAV 1'). 트랙의 trackedBy와 일치."@ko .
bfstkg:atTime a owl:DatatypeProperty ;
    rdfs:domain bfstkg:Observation ; rdfs:range xsd:dateTime ;
    rdfs:label "시각"@ko ; rdfs:comment "관측 시각(ISO8601). 원자료 키: timestamp. 단일 dateTime 리터럴로 직접 부착."@ko .
bfstkg:observedSpeed a owl:DatatypeProperty ;
    rdfs:domain bfstkg:Observation ; rdfs:range xsd:decimal ;
    rdfs:label "관측속도"@ko ; rdfs:comment "실측 속도(m/s). 원자료 키: speed_mps."@ko .
bfstkg:headingDeg a owl:DatatypeProperty ;
    rdfs:domain bfstkg:Observation ; rdfs:range xsd:decimal ;
    rdfs:label "방위각"@ko ; rdfs:comment "원자료 키: heading_deg."@ko .
bfstkg:observedPredicate a owl:ObjectProperty ;
    rdfs:domain bfstkg:Observation ; rdfs:range rdf:Property ;
    rdfs:label "관측관계술어"@ko ; rdfs:comment "이 관측이 담은 동적 관계 술어 IRI(S4.4). 원자료 키: predicate. 매핑: 'move to'→moveTo, 'Follow-Entity'→follows, 'FFE-on-Location'→indirectFireAt, 'fired_by'→hitBy, 'find_cover'→takesCoverFrom, 'none'→생략."@ko .
# [수정 2026-08-25] range 합집합에 EntityMarking 추가.
#   ver1.0 의 Follow-Entity·Fire-Weapon·find_cover 는 object 가 트랙 ID가 아니라
#   정답 마킹(ENINF001)이다. 한 마킹이 여러 tracking_id 로 나뉘어 나타나므로
#   트랙으로 환원할 수 없어 마킹 자체를 노드로 둔다(stkg_ext X3).
#   ※ OWL 에서 rdfs:range 를 다른 파일에 또 선언하면 교집합이 되어 더 좁아진다.
#     넓히려면 이 합집합 자체를 고쳐야 하므로 확장 파일이 아니라 여기서 고친다.
bfstkg:observedObject a owl:ObjectProperty ;
    rdfs:domain bfstkg:Observation ;
    rdfs:range [ a owl:Class ; owl:unionOf ( bfstkg:Track bfstkg:PlaceRef geo:Geometry bfstkg:EntityMarking ) ] ;
    rdfs:label "관측대상"@ko ; rdfs:comment "관계의 대상: 트랙(개체) / 장소(LOC_*, PlaceRef) / raw 좌표(geo:Geometry 노드, 좌표는 geo:asWKT) / 정답 마킹(EntityMarking). 원자료 키: object (빈 값 가능)."@ko .
bfstkg:cid a owl:ObjectProperty ;
    rdfs:domain bfstkg:Observation ; rdfs:range bfstkg:RecognitionLevel ;
    rdfs:label "인식수준"@ko , "recognitionLevel"@en ;
    rdfs:comment "센서 인식 수준. 원자료 키: CID (정수 0~4 → S7 개체로 매핑). ※ 식별 ID가 아니라 인식 품질 단계 — 여러 대상이 같은 값을 갖고, 같은 대상도 관측마다 바뀐다."@ko .
bfstkg:levelValue a owl:DatatypeProperty ;
    rdfs:domain bfstkg:RecognitionLevel ; rdfs:range xsd:integer ;
    rdfs:label "수준값"@ko ; rdfs:comment "인식수준의 정수 코드(0~4). 원자료 CID 정수와 대응."@ko .
# 위치: GeoSPARQL geo:hasGeometry 로 Observation에 점 부착. geo:asWKT "POINT Z(lon lat)". (S5 지명과 동일 방식)

#################################################################
# S4.3. 트랙 식별 · 개체 정합 (entity resolution)
#   Track = 관측자별 대상. 관측자가 부여한 trackingID로 식별 → 식별키 (관측자 + trackingID).
#   subject(ENCAESAR002)는 정답(ground-truth) 실개체 마킹 → groundTruthMarking에 보관(정합 정답지).
#   실제 정합(어느 트랙들이 같은 실개체인가)은 별도 연구 — 적재 시 resolvedTo는 비운다.
#   [정정 2026-08-06] trackingID 컬럼 신설 반영: 트랙 식별을 subject가 아닌 trackingID로.
#     (구 cid는 식별자 아님→인식수준으로 S4.2 이동, 구 localMarking→groundTruthMarking 개명)
#################################################################

bfstkg:trackedBy a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:domain bfstkg:Track ; rdfs:range bfstkg:Observer ;
    rdfs:label "트랙관측자"@ko ; rdfs:comment "이 트랙을 인식한 관측자. 관측자별로 트랙을 분리한다."@ko .
bfstkg:trackingId a owl:DatatypeProperty ;
    rdfs:domain bfstkg:Track ; rdfs:range xsd:string ;
    rdfs:label "트랙ID"@ko ; rdfs:comment "관측자가 부여한 트랙 식별자. 원자료 키: trackingID (신규 컬럼). 트랙 식별키 = (관측자 + trackingID)."@ko .
bfstkg:groundTruthMarking a owl:DatatypeProperty ;
    rdfs:domain bfstkg:Track ; rdfs:range xsd:string ;
    rdfs:label "정답마킹"@ko ; rdfs:comment "이 트랙의 정답 실개체 마킹. 원자료 키: subject (예 'ENCAESAR002' = EN-CAESAR-002; 규칙: FACTION+TYPE+seq, oob에서 하이픈 제거·11자). ground-truth라 전역 유일 — 정합 평가의 정답지."@ko .
bfstkg:resolvedTo a owl:ObjectProperty ;
    rdfs:domain bfstkg:Track ; rdfs:range bfstkg:BattlefieldEntity ;
    owl:inverseOf bfstkg:resolvedFrom ;
    rdfs:label "정합개체"@ko ; rdfs:comment "정합 연구가 이 트랙을 어느 실개체로 판정했는가. 적재 단계에선 비운다."@ko .
bfstkg:resolvedFrom a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:Track ;
    rdfs:label "정합출처트랙"@ko ; rdfs:comment "이 실개체로 정합된 관측자별 트랙들."@ko .

#################################################################
# S4.4. 동적 관계 어휘 — observedPredicate 의 값 (관측이 담는 행동/관계)
#   기준(정본): 참고자료3차/VR-Forces-main/VR-Forces_task_list.xlsx (태스크 22종·7그룹).
#   Observation.observedPredicate 가 이 IRI들을 '값'으로 가진다(리파이). 각 술어의
#   domain/range는 '의도된 실세계 주체·대상' 문서 — 실제 주체는 Observation,
#   대상은 observedObject(Track ∪ PlaceRef).
#   ※ 값형 태스크(set speed·wait duration)는 대상이 값이라 DatatypeProperty로
#     아래 '값형 태스크' 그룹에 둔다(관계 아님). 실측 속도는 observedSpeed(S4.2)로 별개.
#     set aiming point → 대상 조준이면 setAimingPoint(Object) / 방위각만이면 headingDeg류(Datatype)
#   [재정비 2026-08-06] task_list.xlsx 기준 재작성. 구 개체별가능한관계.txt 발 여분 술어
#     (gatherAt·approach·hitArea·transportTo·stopAt·occupy·defend·locatedAt·damagedBy·
#      suppressedBy·stateChangedTo 등) 제거. followEntity는 여기로(구 S4.5 follows 대체).
#################################################################

#--- 이동/기동 ---
bfstkg:moveToLocation a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range geo:Geometry ;
    rdfs:label "좌표이동"@ko , "move to location"@en ; rdfs:comment "특정 좌표로 이동. 목적지=geometry 노드(좌표는 그 안 geo:asWKT 리터럴). GeoSPARQL 표준 — CRS·공간쿼리 위해 노드로. 명명 지점 이동은 moveTo(→PlaceRef)."@ko .
# move along → 삭제 (route 데이터 형태 미확정 + 현재 CSV에 없음). 실제 route 데이터 오면 재정의.
bfstkg:moveTo a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:PlaceRef ;
    rdfs:label "이동"@ko , "move to"@en ; rdfs:comment "waypoint(명명 지점)로 이동. CSV predicate 'move to'."@ko .
bfstkg:followEntity a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:BattlefieldEntity ;
    rdfs:label "객체추종"@ko , "follow entity"@en ; rdfs:comment "객체를 따라 이동. CSV 'Follow-Entity'. (구 S4.5 follows 대체)"@ko .
bfstkg:animatedMovement a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:PlaceRef ;
    rdfs:label "행동동반이동"@ko , "animated movement"@en ; rdfs:comment "애니메이션 기반 정밀 이동(지점별 행동 동반)."@ko .

#--- 직접 사격 ---
bfstkg:fireAtTarget a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ;
    rdfs:range [ a owl:Class ; owl:unionOf ( bfstkg:BattlefieldEntity bfstkg:PlaceRef ) ] ;
    rdfs:label "직접사격"@ko , "fire at target"@en ; rdfs:comment "대상(개체/좌표) 직접 사격."@ko .
bfstkg:provideSuppressiveFire a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:PlaceRef ;
    rdfs:label "제압사격"@ko , "provide suppressive fire"@en ; rdfs:comment "좌표 제압사격."@ko .
bfstkg:engageFromCover a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:BattlefieldEntity ;
    rdfs:label "엄폐교전"@ko , "engage from cover"@en ; rdfs:comment "엄폐 상태에서 교전."@ko .

#--- 간접 사격 ---
bfstkg:ffeOnEntity a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:BattlefieldEntity ;
    rdfs:label "객체화력집중"@ko , "ffe on entity"@en ; rdfs:comment "객체 대상 화력집중(간접사격)."@ko .
bfstkg:ffeOnLocation a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:PlaceRef ;
    rdfs:label "좌표화력집중"@ko , "ffe on location"@en ; rdfs:comment "좌표 대상 화력집중. CSV 'FFE-on-Location'."@ko .
bfstkg:ffeOnTarget a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ;
    rdfs:range [ a owl:Class ; owl:unionOf ( bfstkg:BattlefieldEntity bfstkg:PlaceRef ) ] ;
    rdfs:label "표적화력집중"@ko , "ffe on target"@en ; rdfs:comment "target/통제점 대상 화력집중."@ko .

#--- 생존 및 위치 선정 ---
bfstkg:findCover a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:BattlefieldEntity ;
    rdfs:label "엄폐탐색"@ko , "find cover"@en ; rdfs:comment "피격 후 위협 개체로부터 엄폐물 탐색/이동. CSV 'find_cover'(Threat=위협)."@ko .
bfstkg:findFiringPosition a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:PlaceRef ;
    rdfs:label "사격위치탐색"@ko , "find firing position"@en ; rdfs:comment "사격 가능 위치 탐색."@ko .

#--- 보병 특수행동 ---
bfstkg:placeIED a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:PlaceRef ;
    rdfs:label "IED설치"@ko , "place ied"@en ; rdfs:comment "IED 설치 후 이탈. 설치 지점."@ko .
bfstkg:throwGrenade a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ;
    rdfs:range [ a owl:Class ; owl:unionOf ( bfstkg:BattlefieldEntity bfstkg:PlaceRef ) ] ;
    rdfs:label "수류탄투척"@ko , "throw grenade"@en ; rdfs:comment "수류탄 투척(좌표/대상)."@ko .

#--- 탑승/하차 ---
bfstkg:embark a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:Vehicle ;
    rdfs:label "탑승"@ko , "embark"@en ; rdfs:comment "차량 탑승."@ko .
bfstkg:disembark a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:Vehicle ;
    rdfs:label "하차"@ko , "disembark"@en ; rdfs:comment "차량 하차."@ko .

#--- 상태 설정 (관계형) ---
bfstkg:setTarget a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:BattlefieldEntity ;
    rdfs:label "교전목표지정"@ko , "set target"@en ; rdfs:comment "교전 목표 지정."@ko .
bfstkg:setAimingPoint a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ;
    rdfs:range [ a owl:Class ; owl:unionOf ( bfstkg:BattlefieldEntity bfstkg:PlaceRef ) ] ;
    rdfs:label "조준"@ko , "set aiming point"@en ; rdfs:comment "대상/좌표 조준. 방위각만 지정이면 headingDeg류 Datatype로 별도."@ko .
bfstkg:setSpotReportingRequest a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:BattlefieldEntity ;
    rdfs:label "발견보고"@ko , "set spot reporting request"@en ; rdfs:comment "발견 보고 요청(보고 상대)."@ko .

#--- 데이터 파생 (task_list엔 없으나 CSV predicate에 존재) ---
bfstkg:firedBy a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:BattlefieldEntity ;
    rdfs:label "피격"@ko , "fired by"@en ; rdfs:comment "발사체가 사수로부터 발사됨(피동). CSV 'fired_by'(대상=확정 사수). fire의 역방향."@ko .

#--- 값형 태스크 (Datatype — 대상이 관계가 아니라 값. task_list '상태 설정'·'대기') ---
bfstkg:setSpeed a owl:DatatypeProperty ;
    rdfs:domain bfstkg:Observation ; rdfs:range xsd:decimal ;
    rdfs:label "지정속도"@ko , "set speed"@en ; rdfs:comment "이동 속도 지정(m/s). task 'set speed'. 값형이라 관계 아님. 실측 속도 observedSpeed(S4.2)와 구분(명령값). 현재 CSV엔 소스 없음."@ko .
bfstkg:waitDuration a owl:DatatypeProperty ;
    rdfs:domain bfstkg:Observation ; rdfs:range xsd:decimal ;
    rdfs:label "대기시간"@ko , "wait duration"@en ; rdfs:comment "지정 시간 대기(초). task 'wait duration'. 값형이라 관계 아님. 현재 CSV엔 소스 없음."@ko .

#################################################################
# S4.5. 구조·지속 관계 술어 — 실개체(BattlefieldEntity) 간 (config 소스 있는 것만)
#   편제·세력·탑승·계열. 관측 스트림엔 없고, config(roster·dis_catalog) 조인 +
#   개체 정합(S4.3) 후 실개체에 부여한다.
#   [트림 2026-08-06] 실데이터 소스 없던 10종 제거 — 지침/31회차 유산이나 config·CSV에
#     채울 소스 없음: near·engagedWith·supports·screens·reinforces·detects·
#     receivesSpotReportFrom·taskedBySuperior·superiorOf·participatesIn.
#     (participatesIn 제거로 Event 클래스는 참조 없음 → S4.1에서 '미사용' 유지)
#   추론기 미사용 → 대칭·역관계는 양방향 명시 (설계안 §5.5).
#################################################################

#--- 편제 (roster.json) ---
bfstkg:partOf a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:MilitaryUnit ;
    owl:inverseOf bfstkg:hasSubUnit ;
    rdfs:label "소속"@ko ; rdfs:comment "하위 제대·구성요소 관계."@ko .
bfstkg:hasSubUnit a owl:ObjectProperty ;
    rdfs:domain bfstkg:MilitaryUnit ; rdfs:range bfstkg:BattlefieldEntity ;
    rdfs:label "예하부대"@ko .
bfstkg:memberOfUnit a owl:ObjectProperty ;
    rdfs:subPropertyOf bfstkg:partOf ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:MilitaryUnit ;
    rdfs:label "유닛 소속"@ko ; rdfs:comment "31회차 술어. partOf의 하위속성 (Q4)."@ko .

#--- 세력 (subject 접두어 EN/FR) ---
bfstkg:hasForce a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:Faction ;
    rdfs:label "소속세력"@ko ; rdfs:comment "subject 접두어(EN/FR)로 도출."@ko .

#--- 탑승 (S4.4 embark 액션에서 상태 도출) ---
bfstkg:embarkedOn a owl:ObjectProperty ;
    rdfs:domain bfstkg:BattlefieldEntity ; rdfs:range bfstkg:Vehicle ;
    owl:inverseOf bfstkg:carries ;
    rdfs:label "탑승중"@ko .
bfstkg:carries a owl:ObjectProperty ;
    rdfs:domain bfstkg:Vehicle ; rdfs:range bfstkg:BattlefieldEntity ;
    rdfs:label "수송"@ko .

#--- 기종 간 유사성 (dis_catalog, L1→L1) ---
bfstkg:sameFamily a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain bfstkg:EntityModel ; rdfs:range bfstkg:EntityModel ;
    rdfs:label "동일계열"@ko ; rdfs:comment "enumCode 6자리 일치로 도출 (대칭). dis_catalog.csv 조인."@ko .

#################################################################
## S4 끝 (개편 2026-08-05, 관측 중심 모델).
##  클래스 7: Observer · Track · Observation · Landmark · PlaceRef · Event · RecognitionLevel
##  속성: S4.2 관측 8(cid 포함) + levelValue + S4.3 트랙·정합 5
##        + S4.4 동적관계 20 + 값형 태스크 2(setSpeed·waitDuration) + firedBy(파생)
##        + S4.5 구조관계 7(config 소스).
##        ※ S4.6(선택 속성 7종: 신뢰도·유형·명칭·mgrs·entityState·source) 삭제 —
##          obs JSON 가정이라 이 CSV엔 소스 없음. 필요 시 되살림.
##        ※ move along은 route 형태 미확정 + 데이터 없어 삭제(추후 재정의)
##  참조 인스턴스: S5 지명 29 · S6 관측자 5 · S7 인식수준 5 (아래).
## (hostileTo는 SC.3에 이미 정의됨)
#################################################################

#################################################################
# S5. 지명(Landmark) 참조 인스턴스
#   출처: 참고자료3차/VR-Forces-main/config/battlefield_layout.json
#   자동 생성 — 손수정 금지, layout 갱신 시 재생성. IRI 로컬명 = CSV object의 LOC_* 키.
#################################################################

bfstkg:LOC_남측고지관측소 a bfstkg:Landmark ;
    rdfs:label "남측고지관측소"@ko ;
    dcterms:provenance "golden" ;
    geo:hasGeometry [ a sf:Point ;
        geo:asWKT "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT Z(-157.7560633 21.3822336 33.5)"^^geo:wktLiteral ] .


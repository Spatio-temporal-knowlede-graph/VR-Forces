#################################################################
#################################################################


#################################################################
# S3.1. 전차 (Tank) — 4종
#################################################################

bfstkg:T-69_MBT a owl:NamedIndividual , bfstkg:EntityModel ;
    bfstkg:hasFaction         bfstkg:FriendlyForce ;
    bfstkg:canEmbark       true ;
    bfstkg:canBeEmbarkedOn false ;
    bfstkg:maxSpeed        "16.66"^^xsd:decimal ;
    bfstkg:movementType    bfstkg:ground-tracked ;
    bfstkg:damageType      bfstkg:ground-heavy-armor ;
    bfstkg:hasWeapon    bfstkg:Cannon_125mm ;
    bfstkg:activeSonarSignature  "0"^^xsd:decimal ;
    bfstkg:infraredSignature     "4"^^xsd:decimal ;
    bfstkg:madSignature          "0"^^xsd:decimal ;
    bfstkg:passiveSonarSignature "0"^^xsd:decimal ;
    bfstkg:radarSignature        "0.5"^^xsd:decimal ;
    bfstkg:visualSignature       "3"^^xsd:decimal ;
    bfstkg:hasSensor            true ;
    bfstkg:canReceiveSpotReport true ;
    bfstkg:canCarry             false ;
    bfstkg:enumCode "1:1:1:45:1:2:1:0" ;
    bfstkg:hasCapableAction
        bfstkg:MoveToLocation , bfstkg:MoveToWaypoint , bfstkg:MoveAlongRoute ,

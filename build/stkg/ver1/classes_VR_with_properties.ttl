@prefix bfstkg:  <https://example.org/onto/battlefield-stkg#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix time:    <http://www.w3.org/2006/time#> .
@prefix sf:      <http://www.opengis.net/ont/sf#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .


## 우선 주석처리 함. 추후 문제될 시 분석 필요
# <https://example.org/onto/battlefield-stkg/individual>
#     a owl:Ontology ;
#     dcterms:title "전장 STKG 온톨로지 (스키마+어휘+카탈로그)"@ko ;
#     owl:versionInfo "1.0 — SC 스키마 + S1·S2 어휘 + S3 카탈로그 26종 + S4 관측양식" .
# #   owl:imports <https://example.org/onto/battlefield-stkg/classes> ;

# Hill 395 object-type taxonomy (faction-functional). Faction is baked
# into the type so cross-faction merges are structurally avoided; same
# category across factions yields hard negatives. v_max is state-
# conditioned; towed weapons / org nodes self-propel at 0.

#################################################################
## Class and Taxonomy Definition
## 계층적 구조 재설정 ver3.3
#################################################################


#################################################################
# 최상위 클래스 정의
# 1. 전장개체(BattlefieldEntity)
# 2. 자연지형(NatureTerrain)
# 3. 기상조건(WeatherCondition) (보류)
#################################################################

bfstkg:BattlefieldEntity a owl:Class ;
    rdfs:label "전장개체"@ko , "BattlefieldEntity"@en ;
    rdfs:comment "전장 STKG가 다루는 모든 개체의 최상위 클래스."@ko .

bfstkg:NatureTerrain a owl:Class ;
    rdfs:label "자연지형"@ko , "NatureTerrain"@en .

bfstkg:WeatherCondition a owl:Class ;
    rdfs:label "기상조건"@ko , "WeatherCondition"@en .

#################################################################
# 전장개체 하위 클래스 정의
# 1.1. 군조직(MilitaryUnit)
# 1.2. 차량(Vehicle)
# 1.3. 무기(Weapon)
# 1.4. 시설물(Facility)
# 1.5. 사람(Person)
#################################################################
# 1.1.
bfstkg:MilitaryUnit a owl:Class ;
    rdfs:subClassOf bfstkg:BattlefieldEntity ;
    rdfs:label "군조직"@ko , "MilitaryUnit"@en ;
    rdfs:comment "지휘체계 상의 군 조직(제대)."@ko .

# 1.2.
bfstkg:Vehicle a owl:Class ;
    rdfs:subClassOf bfstkg:BattlefieldEntity ;
    rdfs:label "차량"@ko , "Vehicle"@en .

# 1.3.
bfstkg:Weapon a owl:Class ;
    rdfs:subClassOf bfstkg:BattlefieldEntity ;
    rdfs:label "무기"@ko , "Weapon"@en .

# 1.4.
bfstkg:Facility a owl:Class ;
    rdfs:subClassOf bfstkg:BattlefieldEntity ;
    rdfs:label "시설물"@ko , "Facility"@en .

#1.5.
bfstkg:Person a owl:Class ;
    rdfs:subClassOf bfstkg:BattlefieldEntity ;
    rdfs:label "사람"@ko , "Person"@en .

#################################################################
# 군조직 하위 클래스 정의
# 1.1.1. 분대(Squad)
# 1.1.2. 소대(Platoon)
# 1.1.3. 중대(Company)
# 1.1.4. 대대(Battalion)
# 1.1.5. 여단(Brigade)
# 1.1.6. 사단(Division)
# 1.1.7. 군단(Corps)
#################################################################
# 1.1.1.
bfstkg:Squad a owl:Class ;
    rdfs:subClassOf bfstkg:MilitaryUnit ; 
    rdfs:label "분대"@ko , "Squad"@en .

# 1.1.2.
bfstkg:Platoon a owl:Class ;
    rdfs:subClassOf bfstkg:MilitaryUnit ; 
    rdfs:label "소대"@ko , "Platoon"@en .

# 1.1.3.
bfstkg:Company a owl:Class ; 
    rdfs:subClassOf bfstkg:MilitaryUnit ; 
    rdfs:label "중대"@ko , "Company"@en .

# 1.1.4.
bfstkg:Battalion a owl:Class ; 
    rdfs:subClassOf bfstkg:MilitaryUnit ;
    rdfs:label "대대"@ko , "Battalion"@en .

# 1.1.5.
bfstkg:Brigade a owl:Class ; 
    rdfs:subClassOf bfstkg:MilitaryUnit ; 
    rdfs:label "여단"@ko , "Brigade"@en .

# 1.1.6.
bfstkg:Division a owl:Class ; 
    rdfs:subClassOf bfstkg:MilitaryUnit ; 
    rdfs:label "사단"@ko , "Division"@en .

# 1.1.7.
bfstkg:Corps a owl:Class ; 
    rdfs:subClassOf bfstkg:MilitaryUnit ;
    rdfs:label "군단"@ko , "Corps"@en .

#################################################################
# 차량 하위 클래스 정의
# 1.2.1. 지상차량(GroundVehicle)
# 1.2.2. 항공기(AirVehicle)
#################################################################
# 1.2.1.
bfstkg:GroundVehicle a owl:Class ;
    rdfs:subClassOf bfstkg:Vehicle ;
    rdfs:label "지상차량"@ko , "GroundVehicle"@en .

# 1.2.2.
bfstkg:AirVehicle a owl:Class ;
    rdfs:subClassOf bfstkg:Vehicle ;
    rdfs:label "항공기"@ko , "AirVehicle"@en .

#################################################################
# 무기 하위 클래스 정의
# 1.3.1. 대전차화기(AntiTankWeapon)
# 1.3.2. 고사포(AntiAircraftGun)
# 1.3.3. 박격포(Mortar)
# 1.3.4. 지대공미사일(SurfaceToAirMissile, SAM)
# 1.3.5. 화포(Cannon)
# 1.3.6. 기관총(MachineGun)
#################################################################
# 1.3.1.
bfstkg:AntiTankWeapon a owl:Class ;
    rdfs:subClassOf bfstkg:Weapon ;
    rdfs:label "대전차화기"@ko , "AntiTankWeapon"@en .

# 1.3.2. 
bfstkg:AntiAircraftGun a owl:Class ;
    rdfs:subClassOf bfstkg:Weapon ;
    rdfs:label "고사포"@ko , "AntiAircraftGun"@en .

# 1.3.3. 
bfstkg:Mortar a owl:Class ;
    rdfs:subClassOf bfstkg:Weapon ;
    rdfs:label "박격포"@ko , "Mortar"@en .

# 1.3.4.
bfstkg:SurfaceToAirMissile a owl:Class ;
    rdfs:subClassOf bfstkg:Weapon ;
    rdfs:label "지대공미사일"@ko , "SurfaceToAirMissile"@en .

# 1.3.5.
bfstkg:Cannon a owl:Class ;
    rdfs:subClassOf bfstkg:Weapon ;
    rdfs:label "화포"@ko , "Cannon"@en .

# 1.3.6.
bfstkg:MachineGun a owl:Class ;
    rdfs:subClassOf bfstkg:Weapon ;
    rdfs:label "기관총"@ko , "MachineGun"@en .

#################################################################
# 시설물 하위 클래스 정의
# 1.4.1. 지휘소(CommandPost)
# 1.4.2. 보급시설(LogisticsFacility)
# 1.4.3. 건물(Building)
# 1.4.4. 바리케이드(Barricade)
#################################################################
# 1.4.1.
bfstkg:CommandPost a owl:Class ;
    rdfs:subClassOf bfstkg:Facility ;
    rdfs:label "지휘소"@ko , "CommandPost"@en .

# 1.4.2. 
bfstkg:LogisticsFacility a owl:Class ;
    rdfs:subClassOf bfstkg:Facility ;
    rdfs:label "보급시설"@ko , "LogisticsFacility"@en .

# 1.4.3. 
bfstkg:Building a owl:Class ;
    rdfs:subClassOf bfstkg:Facility ;
    rdfs:label "건물"@ko , "Building"@en .

# 1.4.4. 
bfstkg:Barricade  a owl:Class ;
    rdfs:subClassOf bfstkg:Facility ;
    rdfs:label "바리케이드"@ko , "Barricade"@en .

#################################################################
# 지상차량 하위 클래스 정의
# 1.2.1.1. 전차(=탱크, Tank)
# 1.2.1.2. 장갑차(ArmoredPersonnelCarrier) 
# 1.2.1.3. 트럭(Truck)
# 1.2.1.4. 자주포(SelfPropelledArtillery)
# 1.2.1.5. 다연장로켓(MultipleRocketLauncher)
#################################################################
# 1.2.1.1.
bfstkg:Tank a owl:Class ;
    rdfs:subClassOf bfstkg:GroundVehicle ;
    rdfs:label "전차"@ko , "Tank"@en .

# 1.2.1.2.
bfstkg:ArmoredPersonnelCarrier a owl:Class ;
    rdfs:subClassOf bfstkg:GroundVehicle ;
    rdfs:label "장갑차"@ko , "ArmoredPersonnelCarrier"@en .

# 1.2.1.3.
bfstkg:Truck a owl:Class ;
    rdfs:subClassOf bfstkg:GroundVehicle ;
    rdfs:label "트럭"@ko , "Truck"@en .

# 1.2.1.4. 
bfstkg:SelfPropelledArtillery a owl:Class ;
    rdfs:subClassOf bfstkg:GroundVehicle ;
    rdfs:label "자주포"@ko , "SelfPropelledArtillery"@en .

# 1.2.1.5. 
bfstkg:MultipleRocketLauncher a owl:Class ;
    rdfs:subClassOf bfstkg:GroundVehicle ;
    rdfs:label "다연장로켓"@ko , "MultipleRocketLauncher"@en ;
    skos:prefLabel "다연장로켓"@ko ;
    skos:altLabel "방사포"@ko ;
    skos:altLabel "다연장로켓시스템"@ko ;
    skos:prefLabel "MultipleRocketLauncher"@en ;
    skos:altLabel "MultipleLaunchRocketSystem"@en ;
    skos:altLabel "MLRS"@en .

#################################################################
# 항공기 하위 클래스 정의 -> 보충해야함
# 1.2.2.1. 무인기(UAV)
#################################################################
# 1.2.2.1.
bfstkg:UAV a owl:Class ;
    rdfs:subClassOf bfstkg:AirVehicle ;
    rdfs:label "무인기"@ko , "UAV"@en .

#################################################################
# 전차 하위 클래스 정의
# 1.2.1.1.1. T-69_MBT #아군
# 1.2.1.1.2. T-80_MBT #아군
# 1.2.1.1.3. T-72_MBT #적군
# 1.2.1.1.4. M1A2_Abrams_MBT #적군
#################################################################
# 1.2.1.1.1.
bfstkg:T-69_MBT a owl:Class ;
    rdfs:subClassOf bfstkg:Tank ;
    rdfs:label "T-69_MBT"@en .    

# 1.2.1.1.2.
bfstkg:T-80_MBT a owl:Class ; 
    rdfs:subClassOf bfstkg:Tank ; 
    rdfs:label "T-80_MBT"@en .

# 1.2.1.1.3.
bfstkg:T-72_MBT a owl:Class ; 
    rdfs:subClassOf bfstkg:Tank ; 
    rdfs:label "T-72_MBT"@en .

# 1.2.1.1.4.
bfstkg:M1A2_Abrams_MBT a owl:Class ; 
    rdfs:subClassOf bfstkg:Tank ; 
    rdfs:label "M1A2_Abrams_MBT"@en .

#################################################################
# 장갑차 하위 클래스 정의
# 1.2.1.2.1. LAV_III_APC #아군
# 1.2.1.2.2. M113_APC #아군
# 1.2.1.2.3. BTR-60_APC #적군
# 1.2.1.2.4. BTR-80_APC #적군
#################################################################
# 1.2.1.2.1.
bfstkg:LAV_III_APC a owl:Class ; 
    rdfs:subClassOf bfstkg:ArmoredPersonnelCarrier ; 
    rdfs:label "LAV_III_APC"@en .

# 1.2.1.2.2.
bfstkg:M113_APC a owl:Class ; 
    rdfs:subClassOf bfstkg:ArmoredPersonnelCarrier ; 
    rdfs:label "M113_APC"@en .

# 1.2.1.2.3.
bfstkg:BTR-60_APC a owl:Class ; 
    rdfs:subClassOf bfstkg:ArmoredPersonnelCarrier ; 
    rdfs:label "BTR-60_APC"@en .

# 1.2.1.2.4.
bfstkg:BTR-80_APC a owl:Class ; 
    rdfs:subClassOf bfstkg:ArmoredPersonnelCarrier ; 
    rdfs:label "BTR-80_APC"@en .

#################################################################
# 트럭 하위 클래스 정의
# 1.2.1.3.1. M1028_FMTV_Canvas_Cargo_Truck #아군
# 1.2.1.3.2. M1083A1_FMTV_Flatbed_Truck #아군
# 1.2.1.3.3. GAZ-66_Truck #적군
# 1.2.1.3.4. M35_Truck #적군
#################################################################
# 1.2.1.3.1. 
bfstkg:M1028_FMTV_Canvas_Cargo_Truck a owl:Class ; 
    rdfs:subClassOf bfstkg:Truck ; 
    rdfs:label "M1028_FMTV_Canvas_Cargo_Truck"@en .

# 1.2.1.3.2. 
bfstkg:M1083A1_FMTV_Flatbed_Truck a owl:Class ; 
    rdfs:subClassOf bfstkg:Truck ; 
    rdfs:label "M1083A1_FMTV_Flatbed_Truck"@en .

# 1.2.1.3.3.
bfstkg:GAZ-66_Truck a owl:Class ; 
    rdfs:subClassOf bfstkg:Truck ; 
    rdfs:label "GAZ-66_Truck"@en .

# 1.2.1.3.4. 
bfstkg:M35_Truck a owl:Class ; 
    rdfs:subClassOf bfstkg:Truck ; 
    rdfs:label "M35_Truck"@en .

#################################################################
# 자주포 하위 클래스 정의
# 1.2.1.4.1. AHS_Krab_Howitzer #아군
# 1.2.1.4.2. M109_Howitzer #아군
# 1.2.1.4.3. CAESAR_SP_Howitzer #적군
#################################################################
# 1.2.1.4.1. 
bfstkg:AHS_Krab_Howitzer a owl:Class ;
    rdfs:subClassOf bfstkg:SelfPropelledArtillery ;
    rdfs:label "AHS_Krab_Howitzer"@en .

# 1.2.1.4.2.
bfstkg:M109_Howitzer a owl:Class ;
    rdfs:subClassOf bfstkg:SelfPropelledArtillery ;
    rdfs:label "M109_Howitzer"@en .

# 1.2.1.4.3.
bfstkg:CAESAR_SP_Howitzer a owl:Class ;
    rdfs:subClassOf bfstkg:SelfPropelledArtillery ;
    rdfs:label "CAESAR_SP_Howitzer"@en .

#################################################################
# 다연장로켓 하위 클래스 정의
# 1.2.1.5.1. M270_MLRS  #아군
# 1.2.1.5.2. ASTROS_II_MLRS  #적군
#################################################################
# 1.2.1.5.1.
bfstkg:M270_MLRS  a owl:Class ;
    rdfs:subClassOf bfstkg:MultipleRocketLauncher ;
    rdfs:label "M270_MLRS"@en .

# 1.2.1.5.2.
bfstkg:ASTROS_II_MLRS  a owl:Class ;
    rdfs:subClassOf bfstkg:MultipleRocketLauncher ;
    rdfs:label "ASTROS_II_MLRS"@en .

#################################################################
# 무인기 하위 클래스 정의
# 1.2.2.1.1. 드론(Drone)
#################################################################
# 1.2.2.1.1.
bfstkg:Drone a owl:Class ;
    rdfs:subClassOf bfstkg:UAV ;
    rdfs:label "드론"@ko , "Drone"@en .

#################################################################
# 대전차화기 하위 클래스 정의
# 1.3.1.1. Javelin #아군
# 1.3.1.2. RPG #적군
#################################################################
# 1.3.1.1. 
bfstkg:Javelin a owl:Class ;
    rdfs:subClassOf bfstkg:AntiTankWeapon ;
    rdfs:label "Javelin"@en .

# 1.3.1.2.
bfstkg:RPG a owl:Class ;
    rdfs:subClassOf bfstkg:AntiTankWeapon;
    rdfs:label "RPG"@en .

#################################################################
# 고사포 하위 클래스 정의
# 1.3.2.1. ZPU-4_AA_Gun #아군/적군
#################################################################
# 1.3.2.1.
bfstkg:ZPU-4_AA_Gun a owl:Class ;
    rdfs:subClassOf bfstkg:AntiAircraftGun ;
    rdfs:label "ZPU-4_AA_Gun"@en .

#################################################################
# 박격포 하위 클래스 정의
# 1.3.3.1. MO-120RT-61_Mortar #아군/적군
#################################################################
# 1.3.3.1.
bfstkg:MO-120RT-61_Mortar a owl:Class ;
    rdfs:subClassOf bfstkg:Mortar ;
    rdfs:label "MO-120RT-61_Mortar"@en .

#################################################################
# 지대공미사일 하위 클래스 정의
# 1.3.4.1. SA7 #아군/적군
# 1.3.4.2. M901_Patriot_Launcher
# 1.3.4.3. MIM-104_Patriot_Launcher
#################################################################
# 1.3.4.1.
bfstkg:SA7 a owl:Class ;
    rdfs:subClassOf bfstkg:SurfaceToAirMissile ;
    rdfs:label "SA7"@en .

# 1.3.4.2.
bfstkg:M901_Patriot_Launcher a owl:Class ;
    rdfs:subClassOf bfstkg:SurfaceToAirMissile ;
    rdfs:label "M901_Patriot_Launcher"@en .

# 1.3.4.3.
bfstkg:MIM-104_Patriot_Launcher a owl:Class ;
    rdfs:subClassOf bfstkg:SurfaceToAirMissile ;
    rdfs:label "MIM-104_Patriot_Launcher"@en .

#################################################################
# 화포 하위 클래스 정의
# 1.3.5.1. Cannon_25mm
# 1.3.5.2. Cannon_30mm
# 1.3.5.3. Cannon_120mm
# 1.3.5.4. Cannon_125mm
# 1.3.5.5. m1a2-multigun
#################################################################
# 1.3.5.1. 
bfstkg:Cannon_25mm a owl:Class ;
    rdfs:subClassOf bfstkg:Cannon ;
    rdfs:label "Cannon_25mm"@en .

# 1.3.5.2. 
bfstkg:Cannon_30mm a owl:Class ;
    rdfs:subClassOf bfstkg:Cannon ;
    rdfs:label "Cannon_30mm"@en .

# 1.3.5.3.
bfstkg:Cannon_120mm a owl:Class ;
    rdfs:subClassOf bfstkg:Cannon ;
    rdfs:label "Cannon_120mm"@en .

# 1.3.5.4.
bfstkg:Cannon_125mm a owl:Class ;
    rdfs:subClassOf bfstkg:Cannon ;
    rdfs:label "Cannon_125mm"@en .

# 1.3.5.5.
bfstkg:m1a2-multigun a owl:Class ;
    rdfs:subClassOf bfstkg:Cannon ;
    rdfs:label "m1a2-multigun"@en ;
    rdfs:comment "시뮬레이터에서 M1A2의 복수 화기를 통합하여 표현한 무장 모델이며, 실제 단일 포를 의미하지 않는다."@ko .


#################################################################
# 기관총 하위 클래스 정의 
# 1.3.6.1. M2-machine-gun 
# 1.3.6.2. M240-7_62mm-machin-gun
#################################################################
# 1.3.6.1.
bfstkg:M2_MG a owl:Class ;
    rdfs:subClassOf bfstkg:MachineGun ;
    rdfs:label "M2_MG"@en .

# 1.3.6.2.
bfstkg:M240_7_62mm_MG a owl:Class ;
    rdfs:subClassOf bfstkg:MachineGun ;
    rdfs:label "M240_7_62mm_MG"@en .

#################################################################
# 자연지형 하위 클래스 정의
# 2.1. 융기지형(ElevatedTerrain)
# 2.2. 함몰지형(DepressedTerrain)
# 2.3. 평탄지형(FlatTerrain)
#################################################################
# 2.1.
bfstkg:ElevatedTerrain a owl:Class ;
    rdfs:subClassOf bfstkg:NatureTerrain ;
    rdfs:label "융기지형"@ko , "ElevatedTerrain"@en .

# 2.2.
bfstkg:DepressedTerrain a owl:Class ;
    rdfs:subClassOf bfstkg:NatureTerrain ;
    rdfs:label "함몰지형"@ko , "DepressedTerrain"@en .

# 2.3.
bfstkg:FlatTerrain a owl:Class ;
    rdfs:subClassOf bfstkg:NatureTerrain ;
    rdfs:label "평탄지형"@ko , "FlatTerrain"@en .

#################################################################
# 융기지형 하위 클래스 정의
# 2.1.1. 산(Mountain)
# 2.1.2. 언덕(Hill)
# 2.1.3. 능선(Ridge)
# 2.1.4. 고지(HighGround)
#################################################################
# 2.1.1.
bfstkg:Mountain a owl:Class ;
    rdfs:subClassOf bfstkg:ElevatedTerrain ;
    rdfs:label "산"@ko , "Mountain"@en .

# 2.1.2.
bfstkg:Hill a owl:Class ;
    rdfs:subClassOf bfstkg:ElevatedTerrain ;
    rdfs:label "언덕"@ko , "Hill"@en .

# 2.1.3.
bfstkg:Ridge a owl:Class ;
    rdfs:subClassOf bfstkg:ElevatedTerrain ;
    rdfs:label "능선"@ko , "Ridge"@en .

# 2.1.4.
bfstkg:HighGround a owl:Class ;
    rdfs:subClassOf bfstkg:ElevatedTerrain ;
    rdfs:label "고지"@ko , "HighGround"@en .

#################################################################
# 함몰지형 하위 클래스 정의
# 2.2.1. 계곡(Valley)
# 2.2.2. 협곡(Canyon)
#################################################################
# 2.2.1. 
bfstkg:Valley a owl:Class ;
    rdfs:subClassOf bfstkg:DepressedTerrain ;
    rdfs:label "계곡"@ko , "Valley"@en .

# 2.2.2.
bfstkg:Canyon a owl:Class ;
    rdfs:subClassOf bfstkg:DepressedTerrain ;
    rdfs:label "협곡"@ko , "Canyon"@en .

#################################################################
# 평탄지형 하위 클래스 정의
# 2.3.1. 평지(Plain)
#################################################################
# 2.3.1.
bfstkg:Plain a owl:Class ;
    rdfs:subClassOf bfstkg:FlatTerrain ;
    rdfs:label "평지"@ko , "Plain"@en .

#################################################################
## Relation(object property) and Property(datatype property) Definition
## 속성 작성 ver1.0
#################################################################

#################################################################
# SC.1. 어휘 컨테이너 클래스
#################################################################

# range로 이름이 등장하나 정의가 없던 것 : ( 전장 개체들이 탑재/휴대하는 무기 종류임) 
bfstkg:Faction a owl:Class ;
    rdfs:label "진영"@ko , "Faction"@en ;
    rdfs:comment "개체가 소속된 세력. bfstkg:weaponType 속성의 치역."@ko .

bfstkg:MovementType a owl:Class ;
    rdfs:label "기동유형"@ko , "MovementType"@en ;
    rdfs:comment "개체의 이동 방식. bfstkg:movementType 속성의 치역."@ko .

bfstkg:DamageType a owl:Class ;
    rdfs:label "피해유형"@ko , "DamageType"@en ;
    rdfs:comment "개체의 피해 산정 모델. bfstkg:damageType 속성의 치역."@ko .

bfstkg:WeaponType a owl:Class ;
    rdfs:label "무장유형"@ko , "WeaponType"@en ;
    rdfs:comment "개체가 탑재한 무장. bfstkg:weaponSystem 속성의 치역."@ko . # 확인 필요

# 본 설계에서 신규 도입 (원자료는 값 목록만 갖고 온톨로지 구조가 없었음)
bfstkg:EntityState a owl:Class ;
    rdfs:label "운동상태"@ko , "EntityState"@en ;
    rdfs:comment "관측 시점의 개체 운동상태. 지침 states 목록 6종."@ko .

bfstkg:SensorSource a owl:Class ;
    rdfs:label "관측출처"@ko , "SensorSource"@en ;
    rdfs:comment "관측을 생성한 센서 계열. 지침 source 목록 5종."@ko .

bfstkg:Action a owl:Class ;
    rdfs:label "행동"@ko , "Action"@en ;
    rdfs:comment "개체가 수행 가능한 행동. 31회차 행동표 28종."@ko .

bfstkg:StateAttribute a owl:Class ;
    rdfs:label "상태속성"@ko , "StateAttribute"@en ;
    rdfs:comment "개체가 보유하는 상태변수의 종류. 31회차 상태표 38종."@ko .

bfstkg:ActionScope a owl:Class ;
    rdfs:label "행동범위"@ko , "ActionScope"@en ;
    rdfs:comment "행동이 개별/유닛/반응형 중 어느 단위인지. 31회차 '구분' 열."@ko .

# 기종 카탈로그용 메타클래스 (지침 794행). S3 punning 대상.
# 차량·화포·보병 기종을 모두 담도록 일반화(EntityModel). (이슈1 결정 2026-07-28)
bfstkg:EntityModel a owl:Class ;
    rdfs:label "개체모델"@ko , "EntityModel"@en ;
    rdfs:comment "장비·인원 기종 그 자체를 개체로 취급하기 위한 메타클래스. 제원(불변 스펙)이 붙는다."@ko .

#################################################################
# SC.2. 속성 — 관측출처 신뢰도 (지침 51~86행 yaml 키)
#################################################################

bfstkg:reliability a owl:DatatypeProperty ;
    rdfs:domain bfstkg:SensorSource ; rdfs:range xsd:decimal ;
    rdfs:label "종합신뢰도"@ko ;
    rdfs:comment "원자료 키: reliability. 0~1."@ko .

bfstkg:typeReliability a owl:DatatypeProperty ;
    rdfs:domain bfstkg:SensorSource ; rdfs:range xsd:decimal ;
    rdfs:label "유형판별신뢰도"@ko ;
    rdfs:comment "원자료 키: type_reliability. 0~1."@ko .

bfstkg:posReliability a owl:DatatypeProperty ;
    rdfs:domain bfstkg:SensorSource ; rdfs:range xsd:decimal ;
    rdfs:label "위치신뢰도"@ko ;
    rdfs:comment "원자료 키: pos_reliability. 0~1."@ko .

bfstkg:cepM a owl:DatatypeProperty ;
    rdfs:range xsd:decimal ;
    rdfs:label "원형공산오차"@ko ;
    rdfs:comment "원자료 키: cep_m. 단위 m. SensorSource와 관측 스냅샷 양쪽에 쓰이므로 domain 미지정."@ko .

#################################################################
# SC.3. 속성 — 행동 범위, 세력 적대관계
#################################################################

bfstkg:actionScope a owl:ObjectProperty ;
    rdfs:domain bfstkg:Action ; rdfs:range bfstkg:ActionScope ;
    rdfs:label "행동범위"@ko .

# 지침 282행 "공통 술어: hostileTo(세력 수준)". 대칭이나 추론기 미사용이므로
# S1에서 양방향 명시. owl:SymmetricProperty 선언은 문서화 목적. (설계안 §5.5)
bfstkg:hostileTo a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain bfstkg:Faction ; rdfs:range bfstkg:Faction ;
    rdfs:label "적대관계"@ko , "hostileTo"@en .

#################################################################
# SC.5. 속성 — 기종 카탈로그(L1) 제원 (S3). domain = EntityModel
#        근거: 지침 817~832행, 각 기종 세부스펙
#################################################################

# 범주값(개체를 값으로) → ObjectProperty
bfstkg:hasFaction a owl:ObjectProperty ;
    rdfs:domain bfstkg:EntityModel ; rdfs:range bfstkg:Faction ;
    rdfs:label "진영"@ko , "hasFaction"@en .
bfstkg:movementType a owl:ObjectProperty ;
    rdfs:domain bfstkg:EntityModel ; rdfs:range bfstkg:MovementType ;
    rdfs:label "기동유형"@ko .
bfstkg:damageType a owl:ObjectProperty ;
    rdfs:domain bfstkg:EntityModel ; rdfs:range bfstkg:DamageType ;
    rdfs:label "피해유형"@ko .
bfstkg:hasWeapon a owl:ObjectProperty ;
    rdfs:domain bfstkg:EntityModel ; rdfs:range bfstkg:WeaponType ;
    rdfs:label "무장"@ko .

# 리터럴 → DatatypeProperty
bfstkg:maxSpeed a owl:DatatypeProperty ;
    rdfs:domain bfstkg:EntityModel ; rdfs:range xsd:decimal ;
    rdfs:label "최고속도"@ko ; rdfs:comment "m/s."@ko .
bfstkg:canEmbark a owl:DatatypeProperty ;
    rdfs:domain bfstkg:EntityModel ; rdfs:range xsd:boolean ;
    rdfs:label "탑승 가능"@ko .
bfstkg:canBeEmbarkedOn a owl:DatatypeProperty ;
    rdfs:domain bfstkg:EntityModel ; rdfs:range xsd:boolean ;
    rdfs:label "피탑승(수송) 가능"@ko .

bfstkg:activeSonarSignature  a owl:DatatypeProperty ; rdfs:domain bfstkg:EntityModel ; rdfs:range xsd:decimal .
bfstkg:infraredSignature     a owl:DatatypeProperty ; rdfs:domain bfstkg:EntityModel ; rdfs:range xsd:decimal .
bfstkg:madSignature          a owl:DatatypeProperty ; rdfs:domain bfstkg:EntityModel ; rdfs:range xsd:decimal .
bfstkg:passiveSonarSignature a owl:DatatypeProperty ; rdfs:domain bfstkg:EntityModel ; rdfs:range xsd:decimal .
bfstkg:radarSignature        a owl:DatatypeProperty ; rdfs:domain bfstkg:EntityModel ; rdfs:range xsd:decimal .
bfstkg:visualSignature       a owl:DatatypeProperty ; rdfs:domain bfstkg:EntityModel ; rdfs:range xsd:decimal .

# 능력 플래그 (31회차)
bfstkg:hasSensor            a owl:DatatypeProperty ; rdfs:domain bfstkg:EntityModel ; rdfs:range xsd:boolean ;
    rdfs:label "센서 보유"@ko .
bfstkg:canReceiveSpotReport a owl:DatatypeProperty ; rdfs:domain bfstkg:EntityModel ; rdfs:range xsd:boolean ;
    rdfs:label "관측보고 수신 가능"@ko .
bfstkg:canCarry            a owl:DatatypeProperty ; rdfs:domain bfstkg:EntityModel ; rdfs:range xsd:boolean ;
    rdfs:label "병력 수송 가능"@ko .

# 가능 행동·상태변수 (S1/S2 어휘를 가리킴)
bfstkg:hasCapableAction  a owl:ObjectProperty ;
    rdfs:domain bfstkg:EntityModel ; rdfs:range bfstkg:Action ;
    rdfs:label "가능 행동"@ko .
bfstkg:hasStateAttribute a owl:ObjectProperty ;
    rdfs:domain bfstkg:EntityModel ; rdfs:range bfstkg:StateAttribute ;
    rdfs:label "보유 상태변수"@ko .

# 원자료 8자리 열거 코드 (sameFamily 도출용, 지침 305행 등)
bfstkg:enumCode a owl:DatatypeProperty ;
    rdfs:domain bfstkg:EntityModel ; rdfs:range xsd:string ;
    rdfs:label "열거코드"@ko .

# ── S4(관측 양식) 착수 시 추가할 스키마 ──
#    SpatioTemporalState 클래스, hasState/atTime/observedSpeed/headingDeg/
#    entityState/source/stateConfidence/typeConfidence 속성,
#    관계 술어 24종(partOf, engagedWith, firesAt, movesToward, …)


#################################################################
# SC.4. 개체 유형 클래스 — 보병 계층 (Q3 → 2026-07-29 개정)
#################################################################


#################################################################
##  S1.  L0 — 통제어휘 개체
#################################################################


#################################################################
# S1.1. 진영 (Faction) — 3종
#################################################################

bfstkg:FriendlyForce a owl:NamedIndividual , bfstkg:Faction ;
    rdfs:label "아군"@ko , "FriendlyForce"@en .

bfstkg:EnemyForce a owl:NamedIndividual , bfstkg:Faction ;
    rdfs:label "적군"@ko , "EnemyForce"@en .

# [신규] 지침 852행이 "적군? 아군? 중립??"으로 가능성을 언급
bfstkg:NeutralForce a owl:NamedIndividual , bfstkg:Faction ;
    rdfs:label "중립"@ko , "NeutralForce"@en .

# 세력 간 적대관계. 대칭 술어이므로 양방향 명시 (설계안 §5.5)
bfstkg:EnemyForce    bfstkg:hostileTo bfstkg:FriendlyForce .
bfstkg:FriendlyForce bfstkg:hostileTo bfstkg:EnemyForce .


#################################################################
# S1.2. 기동유형 (MovementType) — 4 + 1종
#################################################################

bfstkg:ground-tracked a owl:NamedIndividual , bfstkg:MovementType ;
    rdfs:label "궤도"@ko , "ground-tracked"@en ;
    rdfs:comment "궤도 구동 지상 이동."@ko .

bfstkg:ground-wheels-road a owl:NamedIndividual , bfstkg:MovementType ;
    rdfs:label "차륜(도로)"@ko , "ground-wheels-road"@en ;
    rdfs:comment "포장로 주행 위주 차륜 이동."@ko .

bfstkg:ground-wheels-off-road a owl:NamedIndividual , bfstkg:MovementType ;
    rdfs:label "차륜(야지)"@ko , "ground-wheels-off-road"@en ;
    rdfs:comment "야지 주행 가능 차륜 이동."@ko .

bfstkg:human a owl:NamedIndividual , bfstkg:MovementType ;
    rdfs:label "도보"@ko , "human"@en ;
    rdfs:comment "인원의 도보 이동."@ko .


bfstkg:static a owl:NamedIndividual , bfstkg:MovementType ;
    rdfs:label "고정/피견인"@ko , "static"@en ;
    rdfs:comment "자력 이동 불가. 견인 또는 고정 배치. 전 상태 v_max = 0 (지침 33행)."@ko ;
    skos:closeMatch "towed"@en ;
    skos:note "지침 30회차 mobility 어휘의 'towed'에 대응."@ko .

# [참고] 30회차 mobility ↔ 본 MovementType 대응 (분석안 A-5)
#   foot     ↔ human
#   tracked  ↔ ground-tracked
#   wheeled  ↔ ground-wheels-road / ground-wheels-off-road
#   towed    ↔ static
#   na       ↔  
#   unknown  ↔  


#################################################################
# S1.3. 피해유형 (DamageType) — 4종
#################################################################

bfstkg:ground-heavy-armor a owl:NamedIndividual , bfstkg:DamageType ;
    rdfs:label "지상 중장갑"@ko , "ground-heavy-armor"@en .

bfstkg:ground-light-armor a owl:NamedIndividual , bfstkg:DamageType ;
    rdfs:label "지상 경장갑"@ko , "ground-light-armor"@en .

bfstkg:ground-unarmored a owl:NamedIndividual , bfstkg:DamageType ;
    rdfs:label "지상 비장갑"@ko , "ground-unarmored"@en .

bfstkg:lifeform-default a owl:NamedIndividual , bfstkg:DamageType ;
    rdfs:label "인원"@ko , "lifeform-default"@en .


#################################################################
# S1.4. 무장 (WeaponType) — 15종 (punning 6 + 값 전용 9)
# 출처: 지침 weapon: / 무장 필드 [원자료 전부]
# punning 6종 (Q2 결정):
#   화포 4: Cannon_25mm / Cannon_30mm / Cannon_120mm / Cannon_125mm
#   기관총 2: M2_MG / M240_7_62mm_MG
#################################################################

#--- 화포/기관총: classes_VR.ttl v3.3에 클래스 존재 → punning ---

# [IRI 재정렬 2026-07-29] 원자료 무장명 → v3.3 클래스명에 정렬, 원표기는 altLabel 보존
bfstkg:Cannon_25mm a owl:NamedIndividual , bfstkg:WeaponType ;
    rdfs:label "Cannon_25mm"@en ;
    skos:altLabel "25mm-gun"@en .

bfstkg:Cannon_30mm a owl:NamedIndividual , bfstkg:WeaponType ;
    rdfs:label "Cannon_30mm"@en ;
    skos:altLabel "30mm-gun"@en .

bfstkg:Cannon_125mm a owl:NamedIndividual , bfstkg:WeaponType ;
    rdfs:label "Cannon_125mm"@en ;
    skos:altLabel "125mm-gun"@en .

bfstkg:M2_MG a owl:NamedIndividual , bfstkg:WeaponType ;
    rdfs:label "M2_MG"@en ;
    skos:altLabel "M2-machine-gun"@en .

bfstkg:M240_7_62mm_MG a owl:NamedIndividual , bfstkg:WeaponType ;
    rdfs:label "M240_7_62mm_MG"@en ;
    skos:altLabel "M240-7_62mm-mach-gun"@en ;
    skos:altLabel "M240-7_62mm-machin-gun"@en ;
    skos:note "공식 제식명: Machine Gun, 7.62mm, M240 (FN MAG 계열)"@ko .
 
bfstkg:Cannon_120mm a owl:NamedIndividual , bfstkg:WeaponType ;
    rdfs:label "Cannon_120mm"@en ;
    skos:altLabel "120mm-gun"@en .

bfstkg:m1a2-multigun a owl:NamedIndividual , bfstkg:WeaponType ;
    rdfs:label "m1a2-multigun"@en .

bfstkg:14_5mm-quad-gun a owl:NamedIndividual , bfstkg:WeaponType ;
    rdfs:label "14_5mm-quad-gun"@en ;
    rdfs:comment "ZPU-4 탑재 4연장 14.5mm 고사기관총."@ko .

bfstkg:M327-120mm-mortar a owl:NamedIndividual , bfstkg:WeaponType ;
    rdfs:label "M327-120mm-mortar"@en .

bfstkg:M284-155mm-cannon a owl:NamedIndividual , bfstkg:WeaponType ;
    rdfs:label "M284-155mm-cannon"@en .

bfstkg:patriot-missile-launcher a owl:NamedIndividual , bfstkg:WeaponType ;
    rdfs:label "patriot-missile-launcher"@en .

bfstkg:handheld-RPG-Launcher a owl:NamedIndividual , bfstkg:WeaponType ;
    rdfs:label "handheld-RPG-Launcher"@en ;
    rdfs:comment "원자료상 Javelin·RPG·SA7이 공통으로 이 값을 갖는다. 설계안 Q6 참조."@ko .

bfstkg:handheld-AK47 a owl:NamedIndividual , bfstkg:WeaponType ;
    rdfs:label "handheld-AK47"@en .

bfstkg:handheld-M4 a owl:NamedIndividual , bfstkg:WeaponType ;
    rdfs:label "handheld-M4"@en .

bfstkg:handheld-M60-mg a owl:NamedIndividual , bfstkg:WeaponType ;
    rdfs:label "handheld-M60-mg"@en .


#################################################################
# S1.5. 운동상태 (EntityState) — 6종
# 출처: 지침 41~47행 states yaml [원자료 그대로]
#################################################################

# 상태별 v_max 규칙 (지침 32~36행)
#   이동상태  = 기종 기준속도(maxSpeed)   → Moving
#   Engaging  = 2.0 m/s                  → Firing (분석안 A-6)
#   정적상태  = 0.5 m/s                  → Halted, Emplaced
#   towed     = 전 상태 0 (위 규칙 무시)  → movementType=static


bfstkg:Moving a owl:NamedIndividual , bfstkg:EntityState ;
    rdfs:label "이동중"@ko , "Moving"@en ;
    skos:note "v_max 규칙: 기종의 maxSpeed를 상한으로 한다 (지침 34행)."@ko .

bfstkg:Halted a owl:NamedIndividual , bfstkg:EntityState ;
    rdfs:label "정지"@ko , "Halted"@en ;
    skos:note "v_max 규칙: 정적상태이므로 0.5 m/s (지침 36행). movementType=static이면 0."@ko .

bfstkg:Emplaced a owl:NamedIndividual , bfstkg:EntityState ;
    rdfs:label "진지점령"@ko , "Emplaced"@en ;
    skos:note "v_max 규칙: 정적상태이므로 0.5 m/s (지침 36행). movementType=static이면 0."@ko .

bfstkg:Firing a owl:NamedIndividual , bfstkg:EntityState ;
    rdfs:label "사격중"@ko , "Firing"@en ;
    skos:altLabel "Engaging"@en ;
    skos:note "v_max 규칙: 이 상태의 최대속도는 2.0 m/s (지침 35행). 단 movementType=static이면 0."@ko .

bfstkg:Unknown a owl:NamedIndividual , bfstkg:EntityState ;
    rdfs:label "미상"@ko , "Unknown"@en .

# [표기 변경] 원자료 states 목록은 "Destroyed"이나, S2의 상태속성 Destroyed와
#   IRI가 충돌한다. 팀 결정(2026-07-23)에 따라 운동상태 쪽을 Destroying으로 한다.
#   원자료 표기는 skos:altLabel로 보존한다. 
bfstkg:Destroying a owl:NamedIndividual , bfstkg:EntityState ;
    rdfs:label "파괴됨"@ko , "Destroying"@en ;
    skos:altLabel "Destroyed"@en ;
    rdfs:comment "개체가 파괴된 운동상태. 원자료 states 목록의 Destroyed에 해당한다."@ko .


#################################################################
# S1.6. 관측출처 (SensorSource) — 5종
# 출처: 지침 51~86행 source yaml [원자료 그대로, 수치 포함]
#################################################################

bfstkg:EO_IR a owl:NamedIndividual , bfstkg:SensorSource ;
    rdfs:label "EO/IR"@en , "전자광학/적외선"@ko ;
    rdfs:comment "Electro-optical / infrared imaging tracker"@en ;
    bfstkg:reliability     "0.90"^^xsd:decimal ;
    bfstkg:typeReliability "0.90"^^xsd:decimal ;
    bfstkg:posReliability  "0.80"^^xsd:decimal ;
    bfstkg:cepM            "15.0"^^xsd:decimal .

bfstkg:RADAR a owl:NamedIndividual , bfstkg:SensorSource ;
    rdfs:label "RADAR"@en , "레이더"@ko ;
    rdfs:comment "Ground surveillance / counter-battery radar"@en ;
    bfstkg:reliability     "0.80"^^xsd:decimal ;
    bfstkg:typeReliability "0.40"^^xsd:decimal ;   # good kinematics, weak classification
    bfstkg:posReliability  "0.90"^^xsd:decimal ;
    bfstkg:cepM            "30.0"^^xsd:decimal .

bfstkg:SIGINT a owl:NamedIndividual , bfstkg:SensorSource ;
    rdfs:label "SIGINT"@en , "신호정보"@ko ;
    rdfs:comment "Signals-intelligence emitter geolocation"@en ;
    bfstkg:reliability     "0.65"^^xsd:decimal ;
    bfstkg:typeReliability "0.60"^^xsd:decimal ;
    bfstkg:posReliability  "0.55"^^xsd:decimal ;
    bfstkg:cepM            "50.0"^^xsd:decimal .

bfstkg:ACOUSTIC a owl:NamedIndividual , bfstkg:SensorSource ;
    rdfs:label "ACOUSTIC"@en , "음향탐지"@ko ;
    rdfs:comment "Acoustic gunfire / vehicle localisation"@en ;
    bfstkg:reliability     "0.55"^^xsd:decimal ;
    bfstkg:typeReliability "0.30"^^xsd:decimal ;
    bfstkg:posReliability  "0.50"^^xsd:decimal ;
    bfstkg:cepM            "60.0"^^xsd:decimal .

bfstkg:HUMINT a owl:NamedIndividual , bfstkg:SensorSource ;
    rdfs:label "HUMINT"@en , "인간정보"@ko ;
    rdfs:comment "Human report / scout observation"@en ;
    bfstkg:reliability     "0.55"^^xsd:decimal ;
    bfstkg:typeReliability "0.70"^^xsd:decimal ;   # humans classify well, localise poorly
    bfstkg:posReliability  "0.40"^^xsd:decimal ;
    bfstkg:cepM            "90.0"^^xsd:decimal .


#################################################################
# S1.7. 행동범위 (ActionScope) — 3종
# [신규] 31회차 행동표의 '구분' 열(개별/유닛급/반응형)을 개체화.
#        S2에서 각 Action이 이 값을 참조한다.
#################################################################

bfstkg:IndividualScope a owl:NamedIndividual , bfstkg:ActionScope ;
    rdfs:label "개별"@ko , "IndividualScope"@en ;
    rdfs:comment "개별 개체 단위로 지시되는 행동. 20종."@ko .

bfstkg:UnitScope a owl:NamedIndividual , bfstkg:ActionScope ;
    rdfs:label "유닛급"@ko , "UnitScope"@en ;
    rdfs:comment "사격조/분대 등 유닛 단위로 지시되는 행동. 6종."@ko .

bfstkg:ReactiveScope a owl:NamedIndividual , bfstkg:ActionScope ;
    rdfs:label "반응형"@ko , "ReactiveScope"@en ;
    rdfs:comment "지시가 아니라 피격·피제압에 대한 자동 반응. 2종."@ko .



#################################################################
#################################################################
##
##  S2.  L0 — 행동(Action) 28종 + 상태속성(StateAttribute) 38종
##
##  출처: 31회차 "개체별 가능한 행동 28종" 표(지침 194~223행),
##
##  IRI 충돌 주의 (Turtle는 대소문자 구별):
##   - 상태속성 bfstkg:Destroyed ≠ 운동상태 bfstkg:Destroying (S1.5)
##   - 상태속성 bfstkg:TaskedBySuperior ≠ 술어 bfstkg:taskedBySuperior (S4 예정)
##   - 상태속성 bfstkg:Formation ≠ 행동 bfstkg:MoveIntoFormation
##   - 행동 bfstkg:Embark/Disembark ≠ 상태속성 bfstkg:Embarked/Disembarked
##
#################################################################
#################################################################


#################################################################
# S2.1. 행동 — 개별(IndividualScope) 20종
#################################################################

bfstkg:MoveToLocation a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "지정 위치로 이동"@ko , "MoveToLocation"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:MoveToWaypoint a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "웨이포인트로 이동"@ko , "MoveToWaypoint"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:MoveAlongRoute a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "경로 따라 이동"@ko , "MoveAlongRoute"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:MoveAlongRouteWithActions a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "경로 이동+지점별 행동"@ko , "MoveAlongRouteWithActions"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:FollowEntity a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "개체 추종"@ko , "FollowEntity"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:PatrolRoute a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "경로 순찰"@ko , "PatrolRoute"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:PatrolBetween a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "두 지점 왕복 순찰"@ko , "PatrolBetween"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:MoveIntoFormation a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "대형으로 정렬"@ko , "MoveIntoFormation"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:FireAtTarget a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "표적 사격"@ko , "FireAtTarget"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:FireForEffect a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "효력사(간접)"@ko , "FireForEffect"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:IndirectFireEvent a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "간접사격 이벤트 참여"@ko , "IndirectFireEvent"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:ProvideSuppressiveFireAtObject a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "표적 제압사격"@ko , "ProvideSuppressiveFireAtObject"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:ProvideSuppressiveFireAtLocation a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "지역 제압사격"@ko , "ProvideSuppressiveFireAtLocation"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:ThrowGrenade a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "수류탄 투척"@ko , "ThrowGrenade"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:Embark a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "탑승"@ko , "Embark"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:Disembark a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "하차"@ko , "Disembark"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:DisembarkAll a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "전원 하차(수송체)"@ko , "DisembarkAll"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:Dismount a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "도보 전개"@ko , "Dismount"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:SendRadio a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "무전 송신"@ko , "SendRadio"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .

bfstkg:Wait a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "대기"@ko , "Wait"@en ;
    bfstkg:actionScope bfstkg:IndividualScope .


#################################################################
# S2.2. 행동 — 유닛급(UnitScope) 6종
#        원자료상 전부 군인(보병 유닛)에만 가능.
#################################################################

bfstkg:FireTeamTravelToWaypoint a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "사격조 이동"@ko , "FireTeamTravelToWaypoint"@en ;
    bfstkg:actionScope bfstkg:UnitScope .

bfstkg:FireTeamBoundToLocation a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "사격조 약진"@ko , "FireTeamBoundToLocation"@en ;
    bfstkg:actionScope bfstkg:UnitScope .

bfstkg:FireTeamOccupyFirePosition a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "사격진지 점령"@ko , "FireTeamOccupyFirePosition"@en ;
    bfstkg:actionScope bfstkg:UnitScope .

bfstkg:SquadTravelToWaypoint a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "분대 이동"@ko , "SquadTravelToWaypoint"@en ;
    bfstkg:actionScope bfstkg:UnitScope .

bfstkg:MoveBetweenCoverToLocation a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "엄폐물 간 이동"@ko , "MoveBetweenCoverToLocation"@en ;
    bfstkg:actionScope bfstkg:UnitScope .

bfstkg:FireTeamSuppressTarget a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "사격조 제압"@ko , "FireTeamSuppressTarget"@en ;
    bfstkg:actionScope bfstkg:UnitScope .


#################################################################
# S2.3. 행동 — 반응형(ReactiveScope) 2종
#        지시가 아니라 피제압에 대한 자동 반응. 군인 전용.
#################################################################

bfstkg:Suppressed_Crouch a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "피제압 웅크림"@ko , "Suppressed_Crouch"@en ;
    bfstkg:actionScope bfstkg:ReactiveScope .

bfstkg:Suppressed_Prone a owl:NamedIndividual , bfstkg:Action ;
    rdfs:label "피제압 엎드림"@ko , "Suppressed_Prone"@en ;
    bfstkg:actionScope bfstkg:ReactiveScope .


#################################################################
# S2.4. 상태속성 (StateAttribute) — 38종
# 출처: 지침 227~266행 상태표 [원자료 그대로]
#################################################################

bfstkg:Location a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "위치"@ko , "Location"@en .

bfstkg:Heading a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "방위"@ko , "Heading"@en .

bfstkg:CurrentSpeed a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "현재속도"@ko , "CurrentSpeed"@en .

bfstkg:OrderedSpeed a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "지시속도"@ko , "OrderedSpeed"@en .

# 상태속성 Destroyed. 운동상태 bfstkg:Destroying(S1.5)과 별개 IRI. (분석안 A-3)
bfstkg:Destroyed a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "파괴됨"@ko , "Destroyed"@en ;
    rdfs:comment "파괴 여부를 나타내는 상태변수. 운동상태 Destroying과 구분된다."@ko .

bfstkg:Appearance a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "외형(손상표현)"@ko , "Appearance"@en .

bfstkg:Invulnerable a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "무적"@ko , "Invulnerable"@en .

bfstkg:Invisible a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "비가시"@ko , "Invisible"@en .

bfstkg:Undetectable a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "탐지불가"@ko , "Undetectable"@en .

bfstkg:Force a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "소속세력"@ko , "Force"@en .

bfstkg:Superior a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "상급자"@ko , "Superior"@en .

# 상태속성 TaskedBySuperior(대문자). 술어 taskedBySuperior(소문자, S4)와 별개 IRI.
bfstkg:TaskedBySuperior a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "상급지시"@ko , "TaskedBySuperior"@en .

bfstkg:UnitState a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "유닛상태"@ko , "UnitState"@en .

bfstkg:Resources a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "자원(연료·탄약)"@ko , "Resources"@en .

bfstkg:Pitch a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "피치"@ko , "Pitch"@en .

bfstkg:IFF a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "피아식별"@ko , "IFF"@en .

bfstkg:FreezeMovement a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "이동 정지"@ko , "FreezeMovement"@en .

bfstkg:AIEnabled a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "AI 활성"@ko , "AIEnabled"@en .

bfstkg:NavigationEnabled a owl:NamedIndividual , bfstkg:StateAttribute ;
    rdfs:label "항법 활성"@ko , "NavigationEnabled"@en .

# 상태속성 Formation(대형). 행동 MoveIntoFormation과 별개 IRI.

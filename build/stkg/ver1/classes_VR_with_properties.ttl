    dcterms:provenance "golden" ;
    geo:hasGeometry [ a sf:Point ;
        geo:asWKT "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT Z(-157.7532937 21.3751179 53.9)"^^geo:wktLiteral ] .

bfstkg:LOC_목표A a bfstkg:Landmark ;
    rdfs:label "목표A"@ko ;
    dcterms:provenance "golden" ;
    geo:hasGeometry [ a sf:Point ;
        geo:asWKT "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT Z(-157.7509621 21.3782817 44.8)"^^geo:wktLiteral ] .

bfstkg:LOC_목표B a bfstkg:Landmark ;
    rdfs:label "목표B"@ko ;
    dcterms:provenance "golden" ;
    geo:hasGeometry [ a sf:Point ;
        geo:asWKT "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT Z(-157.7500052 21.3826968 34.8)"^^geo:wktLiteral ] .

bfstkg:LOC_북측관측소 a bfstkg:Landmark ;
    rdfs:label "북측관측소"@ko ;
    dcterms:provenance "golden" ;
    geo:hasGeometry [ a sf:Point ;
        geo:asWKT "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT Z(-157.7445502 21.3698895 95.2)"^^geo:wktLiteral ] .

bfstkg:LOC_북측예비방어선 a bfstkg:Landmark ;
    rdfs:label "북측예비방어선"@ko ;
    dcterms:provenance "golden" ;
    geo:hasGeometry [ a sf:Point ;
        geo:asWKT "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT Z(-157.743107 21.373378 44.8)"^^geo:wktLiteral ] .

bfstkg:LOC_북측전방방어선 a bfstkg:Landmark ;
    rdfs:label "북측전방방어선"@ko ;
    dcterms:provenance "golden" ;
    geo:hasGeometry [ a sf:Point ;
        geo:asWKT "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT Z(-157.7444707 21.3754535 60.7)"^^geo:wktLiteral ] .

bfstkg:LOC_서측능선 a bfstkg:Landmark ;
    rdfs:label "서측능선"@ko ;
    dcterms:provenance "golden" ;

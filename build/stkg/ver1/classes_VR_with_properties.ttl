#################################################################
# S6. 관측자(Observer) 참조 인스턴스  [자동 생성 — gen_observers.py]
#   존재: build/stkg/*_annotated.csv 의 source 컬럼에서 수집(열린 집합).
#   좌표: config/fixed_objects.json measured 노트에서 있는 것만. 없으면 좌표 생략.
#   데이터/설정 바뀌면 재생성. label = CSV source 값과 동일(조인용).
#################################################################

bfstkg:ground_truth a bfstkg:Observer ; rdfs:label "GROUND_TRUTH" .   # 좌표 소스 없음(config 미등록)

bfstkg:UAV_1 a bfstkg:Observer ; rdfs:label "UAV 1" ;
    geo:hasGeometry [ a sf:Point ; geo:asWKT "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT Z(-157.7363 21.3995 73)"^^geo:wktLiteral ] .

bfstkg:UAV_2 a bfstkg:Observer ; rdfs:label "UAV 2" ;
    geo:hasGeometry [ a sf:Point ; geo:asWKT "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT Z(-157.7352 21.3969 76)"^^geo:wktLiteral ] .

bfstkg:UAV_3 a bfstkg:Observer ; rdfs:label "UAV 3" ;
    geo:hasGeometry [ a sf:Point ; geo:asWKT "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT Z(-157.7552 21.3809 109)"^^geo:wktLiteral ] .

bfstkg:UAV_4 a bfstkg:Observer ; rdfs:label "UAV 4" ;
    geo:hasGeometry [ a sf:Point ; geo:asWKT "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT Z(-157.7557 21.3840 99)"^^geo:wktLiteral ] .

#################################################################
# S7. 인식수준(RecognitionLevel) 참조 인스턴스
#   원자료 CID 정수(0~4)에 대응. cid 속성이 이 개체들을 가리킨다.
#################################################################

bfstkg:RL_NoDetection a bfstkg:RecognitionLevel ; bfstkg:levelValue 0 ;
    rdfs:label "미탐지"@ko , "No Detection"@en ; rdfs:comment "탐지 안 됨"@ko .
bfstkg:RL_Detected a bfstkg:RecognitionLevel ; bfstkg:levelValue 1 ;
    rdfs:label "탐지"@ko , "Detected"@en ; rdfs:comment "뭔가 있다는 것만 앎"@ko .
bfstkg:RL_Classified a bfstkg:RecognitionLevel ; bfstkg:levelValue 2 ;
    rdfs:label "분류"@ko , "Classified"@en ; rdfs:comment "차량/항공기 등 대분류까지 앎"@ko .
bfstkg:RL_Identified a bfstkg:RecognitionLevel ; bfstkg:levelValue 3 ;
    rdfs:label "식별"@ko , "Identified"@en ; rdfs:comment "기종 식별(예 T-72, BMP-2)"@ko .
bfstkg:RL_FullKnowledge a bfstkg:RecognitionLevel ; bfstkg:levelValue 4 ;
    rdfs:label "완전인지"@ko , "Full Knowledge"@en ; rdfs:comment "위치·타입·상태 등 거의 실개체 수준"@ko .

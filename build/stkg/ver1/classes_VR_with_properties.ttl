    rdfs:label "남측제1방어선"@ko ;
    dcterms:provenance "golden" ;
    geo:hasGeometry [ a sf:Point ;
        geo:asWKT "<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT Z(-157.7390725 21.3866265 2.6)"^^geo:wktLiteral ] .

